# 手元で動かすときの値。秘密情報は使わない（すべて公開してよい値）。
# 本番の値は .env.production にある。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# tictactoe をローカルの anvil (31337) で動かすとき。scripts/dev-up.zsh が使う既定のアドレス
NEXT_PUBLIC_TICTACTOE_ADDRESS_31337=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_SOLO_ADDRESS_31337=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# chain-lens: 取引を読む RPC を自前のものにしたいとき（空なら公開 RPC を使う）
RPC_URL=
