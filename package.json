{
  "name": "web3-samples",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run sync:swagger && next dev",
    "build": "npm run sync:swagger && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "npm run sync:swagger && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run sync:swagger && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "sync:swagger": "node -e \"const fs=require('fs'),p='node_modules/swagger-ui-dist/';fs.mkdirSync('public/swagger',{recursive:true});['swagger-ui.css','swagger-ui-bundle.js','swagger-ui-standalone-preset.js'].forEach(f=>fs.copyFileSync(p+f,'public/swagger/'+f))\"",
    "audit": "node scripts/audit.mjs",
    "wagmi": "wagmi generate"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-query": "5.101.4",
    "next": "16.3.8",
    "next-intl": "4.13.7",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "swagger-ui-dist": "5.32.14",
    "viem": "2.55.19",
    "wagmi": "3.7.6"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wagmi/cli": "2.10.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.26",
    "roughjs": "4.6.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.139.0"
  },
  "overrides": {
    "undici": "7.29.1"
  }
}
