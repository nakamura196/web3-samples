# genji-witness で使う環境変数。
#
# ローカル (anvil) だけで動かすなら、この中の値は 1 つも要りません。
# 公開テストネットに出すときだけ .env.local を作り、**op:// 参照だけ**を書きます。
#   作り方  zsh scripts/setup/testnet-key.zsh
#   使い方  op run --env-file=.env.local -- node scripts/07-sepolia.mjs
#
# .env.local は .gitignore 済みです。実値をここにも .env.local にも書かないこと。

# === 公開テストネット (Sepolia) ===
SEPOLIA_PRIVATE_KEY=op://Personal/genji-witness sepolia/private_key
SEPOLIA_ADDRESS=op://Personal/genji-witness sepolia/address

# === IPFS (Filebase) ===
# 無料枠 5 GB / 1,000 ファイル、クレジットカード不要。
# ダッシュボードで bucket を 1 つ作り、Access Key を発行して 1Password に入れる。
#   op item create --category="API Credential" --vault=Personal --title="genji-witness filebase"
# **Filebase に上げたものは後から消せます。** 取り消せないのは Arweave のほう。
FILEBASE_KEY=op://Personal/genji-witness filebase/access_key
FILEBASE_SECRET=op://Personal/genji-witness filebase/secret_key
FILEBASE_BUCKET=op://Personal/genji-witness filebase/bucket

# === RPC (任意) ===
# 未設定なら lib/chains.mjs の publicRpc を使います。
# 索引を作る (eth_getLogs で全体を舐める) 用途では、無料の公開 RPC は制限に当たります。
#   publicnode  1 回 50,000 ブロック / アドレス指定必須 / 150 回ほどで締め出し
#   1rpc.io     1 回 50 ブロック
# 送信だけなら公開 RPC で足ります。
#SEPOLIA_RPC_URL=
#LOCAL_RPC_URL=
#SEPOLIA_FORK_RPC_URL=

# === 素材の場所 (任意) ===
# 未設定なら ../kouigenji を読みます。読むだけで、書き込みません。
#GENJI_REPO=
