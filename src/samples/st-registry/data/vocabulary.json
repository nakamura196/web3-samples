    },
    {
      "id": "zoning", "ja": "用途地域", "en": "Zoning",
      "tier": "core", "observed": 7, "type": "code",
      "note": "都市計画法第8条第1項第1号に掲げる種類。7社すべてが持つ2項目のうちの1つ。"
    },
    {
      "id": "farBcr", "ja": "容積率・建蔽率", "en": "FAR / building coverage",
