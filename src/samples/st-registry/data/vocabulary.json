      "tier": "recommended", "observed": 2, "type": "area", "unit": "㎡",
      "scopeRequired": true,
      "variants": ["賃貸可能面積", "総賃貸可能面積"],
      "note": "算入範囲の但し書きが要る。実例:「賃貸可能面積（本物件の屋根を含みません。）」"
    },
    {
      "id": "trustee", "ja": "信託受託者", "en": "Trustee",
      "tier": "core", "observed": 6, "type": "entity"
    },
    {
      "id": "trustStart", "ja": "信託設定日", "en": "Trust start",
      "tier": "core", "observed": 5, "type": "date",
      "variants": ["信託設定日", "不動産管理処分信託設定年月日"]
    },
    {
      "id": "trustEnd", "ja": "信託期間満了日", "en": "Trust maturity",
      "tier": "core", "observed": 6, "type": "date"
    },
    {
      "id": "surveyor", "ja": "建物状況の調査業者", "en": "Building surveyor",
      "tier": "recommended", "observed": 4, "type": "entity",
      "variants": ["調査業者"]
    },
    {
      "id": "surveyedAt", "ja": "調査年月", "en": "Surveyed",
      "tier": "recommended", "observed": 4, "type": "date",
      "variants": ["調査年月", "現地調査年月"]
    },
    {
      "id": "repairForecast", "ja": "修繕費の見込み", "en": "Repair forecast",
      "tier": "recommended", "observed": 3, "type": "moneyByPeriod",
      "periodsRequired": true,
      "variants": ["今後1年間に必要とされる修繕費", "今後2〜12年間に必要と想定される修繕費", "緊急", "短期", "中・長期修繕更新費用"],
      "note": "期間の切り方が2区分(1年 / 2〜12年)と3区分(緊急 / 短期 / 中・長期)に割れる。指す範囲はほぼ重なるので、期間を明示した数値の並びとして持つ。"
    },
    {
      "id": "seismicPml", "ja": "地震PML", "en": "Seismic PML",
      "tier": "extension", "observed": 2, "type": "ratio",
      "basisRequired": true,
      "variants": ["地震PML（地震PML値調査業者）", "地震PML値（地震PML値調査業者）", "PML値"],
      "note": "調査業者名を添える慣行が定着している。定義(PML1・50年・超過確率10%)まで書く社もある。"
    },
    {
      "id": "noi", "ja": "運営純収益(NOI)", "en": "Net operating income",
      "tier": "extension", "observed": 1, "type": "money", "unit": "JPY",
      "note": "ケネディクスのみが常に開示する。収益還元の内訳(NOI・NCF・還元利回り・割引率・最終還元利回り・土地建物割合)を出すのは同社の特徴で、他社の共通項目には入らない。"
    }
