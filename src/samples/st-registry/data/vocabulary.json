{
  "version": "0.1",
  "asOf": "2026-08-26",
  "basis": "国内の不動産ST届出書68件(アセットマネージャー7社)の実測から構成。ゼロから設計したものではなく、実務で既に共通している部分を写し、そこに『根拠』『基準時点』の規律を足したもの。",
  "principle": [
    "測定値は「値・根拠・基準時点」の3つで1組。どれが欠けても登録できない。",
    "用途固有の項目は禁じない。ただし上位概念への対応を必ず明示する。",
    "既存の表記を置き換えない。原文の項目名を残したまま、この語彙へ写像する。"
  ],
  "tiers": {
    "core": "7社中5社以上の社内共通項目に現れる。必須。",
    "recommended": "3〜4社に現れる。強く推奨。",
    "extension": "1〜2社。任意。ただし出すなら定義を添える。"
  },
  "fields": [
    {
      "id": "propertyName", "ja": "物件名称", "en": "Property name",
      "tier": "core", "observed": 5, "type": "string",
      "variants": ["物件名称", "物件名"]
    },
    {
      "id": "address", "ja": "所在", "en": "Location",
      "tier": "core", "observed": 4, "type": "string",
      "basisRequired": true, "basisOptions": ["住居表示", "登記簿の地番"],
      "variants": ["所在地", "所在地（住居表示）", "住所", "地番"],
      "note": "ケネディクスは1つの「所在地」に住居表示と地番を条件付きで入れる(注記あり)。同じ列に2種類の識別子が入りうるため、機械可読化ではもっとも厄介。根拠を分けて持つ。"
    },
    {
      "id": "landArea", "ja": "敷地面積", "en": "Land area",
      "tier": "core", "observed": 6, "type": "area", "unit": "㎡",
      "basisRequired": true, "basisOptions": ["登記簿", "実測", "鑑定"],
      "variants": ["敷地面積", "敷地面積（登記簿）"]
    },
    {
      "id": "grossFloorArea", "ja": "延床面積", "en": "Gross floor area",
      "tier": "core", "observed": 5, "type": "area", "unit": "㎡",
